# Public site origin used for canonical URLs, Open Graph and sitemap.
# Override only if the live domain differs.
NEXT_PUBLIC_SITE_URL=https://www.sbist.in

# Where form emails are delivered
ADMISSION_TO_EMAIL=admission@sbist.edu.in
CONTACT_TO_EMAIL=officesbist@gmail.com

# Option A — Resend (recommended on Vercel)
# https://resend.com
RESEND_API_KEY=
MAIL_FROM=SBIST Admissions <admissions@your-verified-domain.com>

# Option B — SMTP (recommended on cPanel / shared hosting)
SMTP_HOST=mail.sbist.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admissions@sbist.in
SMTP_PASS=
# MAIL_FROM can also be used with SMTP
